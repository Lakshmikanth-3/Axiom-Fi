# ── Chain (Base Sepolia testnet) ──────────────────────────────────────────────
CHAIN_ID=84532
RPC_URL=https://base-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# ── Deployer / Agents ─────────────────────────────────────────────────────────
DEPLOYER_PRIVATE_KEY=0x...
AGENT_MASTER_SEED=your-mnemonic-or-64-char-hex-seed

# ── Per-agent private keys (derived from AGENT_MASTER_SEED but stored for convenience) ──
RESEARCH_PRIVATE_KEY=0x...
RISK_PRIVATE_KEY=0x...
EXECUTOR_PRIVATE_KEY=0x...

# ── Per-agent wallet addresses (x402 payment recipients) ─────────────────────
RESEARCH_WALLET=0x...
RISK_WALLET=0x...
EXECUTOR_WALLET=0x...

# ── Uniswap / KeeperHub ───────────────────────────────────────────────────────
UNISWAP_API_KEY=...
KEEPERHUB_API_KEY=...
KEEPERHUB_PAYMENT_ADDRESS=0x...

# ── x402 ─────────────────────────────────────────────────────────────────────
X402_FACILITATOR_URL=https://facilitator.keeperhub.com

# ── 0G Infrastructure ─────────────────────────────────────────────────────────
OG_EVM_RPC=https://evmrpc-testnet.0g.ai
OG_INDEXER_URL=https://indexer-storage-testnet-standard.0g.ai
OG_KV_URL=http://3.101.147.150:6789
OG_STORAGE_URL=https://storage-testnet.0g.ai
OG_FLOW_CONTRACT=0x...
OG_STREAM_ID=axiom_prod_001
OG_PRIVATE_KEY=0x...

# ── Contracts ─────────────────────────────────────────────────────────────────
AGENT_REGISTRY_ADDRESS=0x...
REPUTATION_LEDGER_ADDRESS=0x...

# ── Block explorer ────────────────────────────────────────────────────────────
BASESCAN_API_KEY=...

# ── Agent Onboarding ──────────────────────────────────────────────────────────
# 32-byte hex key for AES-256-CBC encryption of derived agent private keys.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ONBOARD_ENCRYPTION_KEY=<64-char-hex-string>

# Base Sepolia USDC ERC-20 contract address (used in onboarding balance check and bot /balance)
USDC_CONTRACT_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# ── Telegram Bot ──────────────────────────────────────────────────────────────
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=<your-bot-token>

# Production only: public HTTPS URL where Telegram sends webhook updates.
# Must be accessible from the internet (e.g. your Vercel deployment URL).
# Example: https://axiom-fi.vercel.app/api/telegram/webhook
TELEGRAM_WEBHOOK_URL=

# Random secret string for X-Telegram-Bot-Api-Secret-Token header verification.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=<random-hex-string>

# ── Frontend ──────────────────────────────────────────────────────────────────
# Base URL of the deployed frontend — used in Telegram bot deep links.
FRONTEND_URL=https://axiom-fi.vercel.app
